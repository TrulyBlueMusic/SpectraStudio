<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta property="og:title" content="SpectraStudio">
<meta property="og:description" content="Professional spritesheet generator for SpectraVJS">
<meta property="og:image" content="https://raw.githubusercontent.com/TrulyBlueMusic/SpectraStudio/refs/heads/main/favicon.png">
<meta property="og:url" content="https://spectratools.vercel.app/">
<meta property="og:type" content="website">

<meta name="twitter:card" content="summary_large_image">
<link rel="icon" type="image/png" href="favicon.png">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SpectraStudio</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

/* ── THEMES ── */
:root[data-theme="dark"] {
  --bg0:#0a0a0a;--bg1:#111111;--bg2:#1a1a1a;--bg3:#222222;
  --line:#2a2a2a;--line-hi:#444444;--fg0:#f0f0f0;--fg1:#a0a0a0;--fg2:#555555;
  --acc:#e8e8e8;--acc-dim:#666666;--hi:#ffffff;--danger:#ff5555;--warn:#ffaa33;
  --shadow:rgba(0,0,0,0.6);--chk1:#1a1a1a;--chk2:#111111;
}
:root[data-theme="light"] {
  --bg0:#f5f4f0;--bg1:#eeece8;--bg2:#e4e2dd;--bg3:#d8d5cf;
  --line:#c8c5be;--line-hi:#999690;--fg0:#1a1918;--fg1:#5a5854;--fg2:#9a9890;
  --acc:#1a1918;--acc-dim:#888580;--hi:#000000;--danger:#cc2222;--warn:#cc7700;
  --shadow:rgba(0,0,0,0.12);--chk1:#e0ddd8;--chk2:#d0cdc8;
}
:root[data-theme="amoled"] {
  --bg0:#000000;--bg1:#000000;--bg2:#0d0d0d;--bg3:#1a1a1a;
  --line:#2a2a2a;--line-hi:#ffffff;--fg0:#ffffff;--fg1:#bbbbbb;--fg2:#444444;
  --acc:#ffffff;--acc-dim:#555555;--hi:#ffffff;--danger:#ffffff;--warn:#aaaaaa;
  --shadow:rgba(255,255,255,0.05);--chk1:#111111;--chk2:#000000;
}

/* ── RESET ── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{height:100%;}
body{
  font-family:'IBM Plex Sans',sans-serif;font-size:13px;
  background:var(--bg0);color:var(--fg0);height:100vh;
  display:flex;flex-direction:column;overflow:hidden;
  transition:background 0.25s,color 0.25s;
}

/* ── TOPBAR ── */
#topbar{
  display:flex;align-items:center;height:44px;padding:0 16px;
  background:var(--bg1);border-bottom:1px solid var(--line);
  flex-shrink:0;position:relative;z-index:100;
  transition:background 0.25s,border-color 0.25s;
}
.tb-wordmark{
  font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:700;
  letter-spacing:0.18em;color:var(--fg0);text-transform:uppercase;margin-right:20px;
}
.tb-slash{color:var(--fg2);font-family:'IBM Plex Mono',monospace;font-size:11px;margin:0 8px;}
.tb-sub{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--fg2);letter-spacing:0.14em;}
.tb-spacer{flex:1;}
.theme-switcher{display:flex;border:1px solid var(--line);border-radius:3px;overflow:hidden;transition:border-color 0.25s;}
.theme-btn{
  background:transparent;border:none;padding:5px 11px;
  font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.1em;
  color:var(--fg2);cursor:pointer;transition:background 0.15s,color 0.15s;
  border-right:1px solid var(--line);
}
.theme-btn:last-child{border-right:none;}
.theme-btn.active{background:var(--bg3);color:var(--fg0);}
.theme-btn:hover:not(.active){background:var(--bg2);color:var(--fg1);}

/* ── LAYOUT ── */
#body{display:grid;grid-template-columns:280px 1fr;flex:1;overflow:hidden;min-height:0;}

/* ── SIDEBAR ── */
#sidebar{
  background:var(--bg1);border-right:1px solid var(--line);
  display:flex;flex-direction:column;overflow-y:auto;overflow-x:hidden;
  transition:background 0.25s,border-color 0.25s;
}
#sidebar::-webkit-scrollbar{width:4px;}
#sidebar::-webkit-scrollbar-thumb{background:var(--line);border-radius:2px;}
.s-group{border-bottom:1px solid var(--line);transition:border-color 0.25s;}
.s-head{
  padding:8px 14px 7px;background:var(--bg2);
  font-family:'IBM Plex Mono',monospace;font-size:9px;font-weight:700;
  letter-spacing:0.18em;color:var(--fg2);text-transform:uppercase;
  display:flex;align-items:center;gap:8px;
  transition:background 0.25s;
}
.s-head-dot{width:4px;height:4px;border-radius:50%;background:var(--acc-dim);flex-shrink:0;transition:background 0.25s;}
.s-body{padding:12px 14px;display:flex;flex-direction:column;gap:10px;}

/* ── DROPZONE ── */
#dropzone{
  margin:10px 14px;border:1px dashed var(--line-hi);border-radius:2px;
  padding:22px 12px;text-align:center;cursor:pointer;position:relative;
  transition:border-color 0.18s,background 0.18s,transform 0.18s,box-shadow 0.18s;
  background:transparent;
}
#dropzone:hover{border-color:var(--acc);background:var(--bg2);transform:scale(1.01);}
#dropzone.drag-over{
  border-color:var(--fg0);background:var(--bg2);transform:scale(1.02);
  box-shadow:0 0 0 2px var(--fg2) inset;
  animation:dz-dash 0.6s linear infinite;
}
@keyframes dz-dash{
  from{border-dash-offset:0}to{border-dash-offset:16px}
}
#dropzone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;}
.dz-icon{
  font-family:'IBM Plex Mono',monospace;font-size:22px;color:var(--fg2);
  display:block;margin-bottom:8px;transition:transform 0.18s,color 0.18s;
}
#dropzone:hover .dz-icon{transform:translateY(-3px);color:var(--fg1);}
#dropzone.drag-over .dz-icon{transform:translateY(-5px) scale(1.1);color:var(--fg0);}
.dz-label{font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.12em;color:var(--fg1);}
.dz-formats{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg2);margin-top:4px;letter-spacing:0.08em;}
#file-name{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--acc);margin-top:6px;word-break:break-all;}

/* ── FORM ── */
.field{display:flex;flex-direction:column;gap:4px;}
.field-label{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.12em;color:var(--fg2);text-transform:uppercase;}
.field input[type=number],.field input[type=text]{
  background:var(--bg0);border:1px solid var(--line);border-radius:2px;
  color:var(--fg0);font-family:'IBM Plex Mono',monospace;font-size:12px;
  padding:6px 8px;outline:none;transition:border-color 0.15s,background 0.15s;width:100%;
  -moz-appearance:textfield;
}
.field input::-webkit-outer-spin-button,.field input::-webkit-inner-spin-button{-webkit-appearance:none;}
.field input:focus{border-color:var(--acc-dim);background:var(--bg1);}
.field-note{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg2);line-height:1.5;}

/* ── STAT GRID ── */
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:2px;overflow:hidden;}
.stat-cell{background:var(--bg2);padding:7px 8px;transition:background 0.15s;}
.stat-val{font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:700;color:var(--fg0);line-height:1;transition:color 0.15s;}
.stat-lbl{font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--fg2);margin-top:3px;letter-spacing:0.1em;}
.stat-val.bump{animation:stat-bump 0.25s cubic-bezier(0.34,1.56,0.64,1);}
@keyframes stat-bump{0%{transform:scale(1)}50%{transform:scale(1.2)}100%{transform:scale(1)}}

/* ── COLOR ── */
.color-row{display:flex;align-items:center;gap:8px;}
.swatch-wrap{
  width:28px;height:28px;border-radius:2px;border:1px solid var(--line);
  position:relative;overflow:hidden;flex-shrink:0;cursor:pointer;
  transition:transform 0.15s,border-color 0.15s;
}
.swatch-wrap:hover{transform:scale(1.1);border-color:var(--line-hi);}
.swatch-wrap input[type=color]{position:absolute;inset:-4px;width:calc(100% + 8px);height:calc(100% + 8px);opacity:0;cursor:pointer;}
.color-hex-inp{
  background:var(--bg0);border:1px solid var(--line);border-radius:2px;
  color:var(--fg0);font-family:'IBM Plex Mono',monospace;font-size:11px;
  padding:6px 8px;outline:none;flex:1;transition:border-color 0.15s;
}
.color-hex-inp:focus{border-color:var(--acc-dim);}
.palette{display:flex;gap:5px;flex-wrap:wrap;margin-top:2px;}
.pal-dot{
  width:18px;height:18px;border-radius:50%;cursor:pointer;
  border:2px solid transparent;transition:transform 0.15s,border-color 0.2s,box-shadow 0.2s;flex-shrink:0;
}
.pal-dot:hover{transform:scale(1.25);}
.pal-dot.active{border-color:var(--fg0);box-shadow:0 0 0 1px var(--fg2);}

/* ── BUTTONS ── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:8px 12px;border:1px solid var(--line);border-radius:2px;
  background:var(--bg3);color:var(--fg0);
  font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;letter-spacing:0.1em;
  cursor:pointer;text-transform:uppercase;position:relative;overflow:hidden;
  transition:background 0.15s,border-color 0.15s,color 0.15s,transform 0.1s,box-shadow 0.15s;
  white-space:nowrap;
}
.btn:hover{background:var(--bg2);border-color:var(--line-hi);box-shadow:0 2px 8px var(--shadow);}
.btn:active{transform:scale(0.97);}
.btn:disabled{opacity:0.3;cursor:not-allowed;transform:none;}
.btn-full{width:100%;}
.btn-primary{background:var(--fg0);color:var(--bg0);border-color:var(--fg0);}
.btn-primary:hover{background:var(--fg1);border-color:var(--fg1);color:var(--bg0);}
.btn-primary:disabled{opacity:0.25;}
.btn-sm{padding:5px 10px;font-size:9px;}
/* ripple */
.ripple{
  position:absolute;border-radius:50%;background:rgba(255,255,255,0.15);
  transform:scale(0);animation:rpl 0.4s ease-out forwards;pointer-events:none;
}
@keyframes rpl{to{transform:scale(4);opacity:0;}}

/* ── PROGRESS ── */
.prog-wrap{display:none;flex-direction:column;gap:5px;}
.prog-wrap.on{display:flex;}
.prog-track{height:2px;background:var(--line);border-radius:1px;overflow:hidden;}
.prog-fill{height:100%;background:var(--fg0);border-radius:1px;width:0%;transition:width 0.12s ease-out;}
.prog-label{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg1);}

/* ── MAIN ── */
#main{display:flex;flex-direction:column;overflow:hidden;min-height:0;}

/* ── PREVIEW BAR ── */
#preview-bar{
  display:flex;align-items:center;gap:10px;height:36px;padding:0 8px 0 16px;
  background:var(--bg1);border-bottom:1px solid var(--line);flex-shrink:0;
  transition:background 0.25s;
}
.pbar-label{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.14em;color:var(--fg2);text-transform:uppercase;}
#sheet-tabs{display:flex;gap:3px;position:relative;}
.stab{
  font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.1em;
  padding:4px 10px;border-radius:2px;background:transparent;border:1px solid var(--line);
  color:var(--fg2);cursor:pointer;text-transform:uppercase;
  transition:border-color 0.15s,color 0.15s,background 0.15s;
}
.stab:hover{border-color:var(--line-hi);color:var(--fg1);}
.stab.active{background:var(--bg3);border-color:var(--line-hi);color:var(--fg0);}

/* view controls */
#view-controls{display:flex;align-items:center;gap:4px;margin-left:auto;}
.vc-btn{
  font-family:'IBM Plex Mono',monospace;font-size:9px;padding:3px 8px;
  background:transparent;border:1px solid var(--line);border-radius:2px;
  color:var(--fg2);cursor:pointer;transition:all 0.12s;white-space:nowrap;
}
.vc-btn:hover{border-color:var(--line-hi);color:var(--fg0);background:var(--bg2);}
.vc-sep{width:1px;height:16px;background:var(--line);margin:0 2px;}

/* ── LIVE PREVIEW ── */
#live-preview-wrap{
  background:var(--bg1);border-bottom:1px solid var(--line);
  flex-shrink:0;display:none;
}
#live-preview-wrap.on{display:flex;align-items:center;gap:0;}
#live-preview-canvas{
  width:80px;height:60px;flex-shrink:0;
  image-rendering:pixelated;background:var(--bg0);
  border-right:1px solid var(--line);
}
#live-controls{display:flex;align-items:center;gap:6px;padding:0 10px;flex:1;}
.lc-btn{
  font-family:'IBM Plex Mono',monospace;font-size:12px;width:22px;height:22px;
  background:transparent;border:1px solid var(--line);border-radius:2px;
  color:var(--fg1);cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:all 0.12s;flex-shrink:0;
}
.lc-btn:hover{border-color:var(--line-hi);color:var(--fg0);background:var(--bg2);}
.lc-btn.active{background:var(--bg3);color:var(--fg0);border-color:var(--line-hi);}
#live-info{
  font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg2);
  margin-left:auto;display:flex;gap:12px;
}
.li-item{display:flex;flex-direction:column;gap:1px;align-items:flex-end;}
.li-val{color:var(--fg0);font-size:10px;}
.li-lbl{font-size:8px;color:var(--fg2);letter-spacing:0.1em;}

/* ── CANVAS AREA ── */
#canvas-area{
  flex:1;overflow:hidden;min-height:0;position:relative;
  background:var(--bg0);cursor:default;
}
#canvas-viewport{
  position:absolute;inset:0;overflow:hidden;
  background-image:linear-gradient(45deg,var(--chk1) 25%,transparent 25%),
    linear-gradient(-45deg,var(--chk1) 25%,transparent 25%),
    linear-gradient(45deg,transparent 75%,var(--chk1) 75%),
    linear-gradient(-45deg,transparent 75%,var(--chk1) 75%);
  background-size:16px 16px;
  background-position:0 0,0 8px,8px -8px,-8px 0;
  background-color:var(--chk2);
}
#canvas-transform{
  position:absolute;transform-origin:0 0;
  transition:none;will-change:transform;
}
#preview-canvas{
  display:block;image-rendering:pixelated;
  border:1px solid var(--line-hi);
}
#empty{
  position:absolute;inset:0;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:10px;text-align:center;
  pointer-events:none;
}
.empty-glyph{font-family:'IBM Plex Mono',monospace;font-size:40px;color:var(--line);line-height:1;letter-spacing:-0.05em;}
.empty-title{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.18em;color:var(--fg2);text-transform:uppercase;}
.empty-sub{font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg2);line-height:1.8;letter-spacing:0.06em;}

/* ── TIMELINE ── */
#timeline{
  flex-shrink:0;height:60px;background:var(--bg1);border-top:1px solid var(--line);
  display:none;overflow-x:auto;overflow-y:hidden;position:relative;
  transition:background 0.25s;
}
#timeline.on{display:block;}
#timeline::-webkit-scrollbar{height:4px;}
#timeline::-webkit-scrollbar-thumb{background:var(--line);border-radius:2px;}
#timeline-inner{display:flex;height:100%;align-items:center;padding:4px 8px;gap:2px;position:relative;min-width:100%;}
.tl-frame{
  flex-shrink:0;width:44px;height:44px;border:1px solid var(--line);border-radius:2px;
  cursor:pointer;overflow:hidden;position:relative;transition:border-color 0.12s,transform 0.12s;
  background:var(--bg0);
}
.tl-frame:hover{border-color:var(--line-hi);transform:scale(1.05);}
.tl-frame.active{border-color:var(--fg0);}
.tl-frame canvas{width:100%;height:100%;display:block;image-rendering:pixelated;}
#tl-playhead{
  position:absolute;top:0;bottom:0;width:2px;background:var(--fg0);
  pointer-events:none;transition:left 0.08s linear;z-index:5;
}

/* ── STATUS BAR ── */
#statusbar{
  display:flex;align-items:center;gap:0;height:22px;
  background:var(--bg1);border-top:1px solid var(--line);flex-shrink:0;
  font-family:'IBM Plex Mono',monospace;font-size:9px;color:var(--fg2);
  padding:0;overflow:hidden;transition:background 0.25s;
}
.sb-item{
  padding:0 10px;height:100%;display:flex;align-items:center;gap:5px;
  border-right:1px solid var(--line);white-space:nowrap;
}
.sb-item span:last-child{color:var(--fg1);}
.sb-spacer{flex:1;}
.sb-op{padding:0 10px;font-style:italic;color:var(--fg2);}

/* ── OUTPUT ── */
#output-strip{border-top:1px solid var(--line);background:var(--bg1);flex-shrink:0;transition:background 0.25s;}
#output-strip-head{
  display:flex;align-items:center;gap:8px;padding:8px 16px;
  border-bottom:1px solid var(--line);
}
#output-strip-head span{font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.14em;color:var(--fg2);text-transform:uppercase;}
#output-actions{display:none;gap:6px;flex-wrap:wrap;margin-left:auto;}
#output-actions.on{display:flex;}
#output-body{padding:10px 16px;}
#lua-output{
  display:none;background:var(--bg0);border:1px solid var(--line);border-radius:2px;
  padding:10px 12px;font-family:'IBM Plex Mono',monospace;font-size:10px;line-height:1.7;
  white-space:pre;overflow-x:auto;max-height:140px;overflow-y:auto;
  transition:max-height 0.2s ease;
}
#lua-output.on{display:block;}
#lua-output::-webkit-scrollbar{height:4px;width:4px;}
#lua-output::-webkit-scrollbar-thumb{background:var(--line);}
/* syntax highlight classes */
.lua-key{color:var(--fg0);}
.lua-str{color:var(--fg1);}
.lua-num{color:var(--acc);}
.lua-kw{color:var(--fg0);font-weight:700;}
.lua-fn{color:var(--fg1);}
.lua-comment{color:var(--fg2);font-style:italic;}

/* ── GENERATION OVERLAY ── */
#gen-overlay{
  position:fixed;inset:0;z-index:500;
  background:rgba(0,0,0,0.75);backdrop-filter:blur(3px);
  display:none;align-items:center;justify-content:center;
}
#gen-overlay.on{display:flex;}
#gen-modal{
  background:var(--bg1);border:1px solid var(--line);border-radius:3px;
  padding:28px 32px;min-width:340px;display:flex;flex-direction:column;gap:16px;
  animation:modal-in 0.18s ease-out;
}
@keyframes modal-in{from{opacity:0;transform:scale(0.96)}to{opacity:1;transform:scale(1)}}
.gm-title{font-family:'IBM Plex Mono',monospace;font-size:11px;font-weight:700;letter-spacing:0.16em;color:var(--fg0);}
.gm-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.gm-cell{background:var(--bg2);padding:8px 10px;border-radius:2px;}
.gm-val{font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:700;color:var(--fg0);}
.gm-lbl{font-family:'IBM Plex Mono',monospace;font-size:8px;color:var(--fg2);margin-top:2px;letter-spacing:0.1em;}
.gm-bar-track{height:3px;background:var(--line);border-radius:2px;overflow:hidden;}
.gm-bar-fill{height:100%;background:var(--fg0);border-radius:2px;width:0%;transition:width 0.12s ease-out;}
.gm-stage{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--fg1);}
.gm-pct{font-family:'IBM Plex Mono',monospace;font-size:22px;font-weight:700;color:var(--fg0);text-align:center;}

/* ── TOAST ── */
#toast{
  position:fixed;bottom:18px;right:18px;
  background:var(--bg3);border:1px solid var(--line-hi);color:var(--fg0);
  font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.08em;
  padding:8px 14px;border-radius:2px;
  opacity:0;pointer-events:none;z-index:999;
  transition:opacity 0.18s,transform 0.18s;
  transform:translateY(8px);
}
#toast.on{opacity:1;transform:translateY(0);}

/* ── CUSTOM CURSOR ── */
*, *::before, *::after { cursor: none !important; }
#cursor-dot {
  position: fixed; width: 6px; height: 6px; border-radius: 50%;
  background: var(--fg0); pointer-events: none; z-index: 99999;
  transform: translate(-50%, -50%);
  transition: transform 0.08s ease, background 0.15s, width 0.15s, height 0.15s;
  will-change: transform, left, top;
}
#cursor-ring {
  position: fixed; width: 28px; height: 28px; border-radius: 50%;
  border: 1px solid var(--fg2); pointer-events: none; z-index: 99998;
  transform: translate(-50%, -50%);
  transition: width 0.22s cubic-bezier(0.23,1,0.32,1),
              height 0.22s cubic-bezier(0.23,1,0.32,1),
              border-color 0.2s,
              opacity 0.2s;
  will-change: transform, left, top;
  opacity: 0.7;
}
body.cursor-click #cursor-dot { transform: translate(-50%,-50%) scale(0.5); }
body.cursor-hover #cursor-ring { width: 44px; height: 44px; border-color: var(--fg0); opacity: 1; }
body.cursor-grab  #cursor-ring { width: 36px; height: 36px; border-color: var(--fg1); opacity: 0.9; }
body.cursor-text  #cursor-ring { width: 4px; height: 22px; border-radius: 2px; }

/* ── SHEET TABS SCROLL ── */
#sheet-tabs {
  display: flex; gap: 3px; position: relative;
  overflow-x: auto; overflow-y: hidden;
  max-width: 340px; scroll-behavior: smooth;
  scrollbar-width: none;
}
#sheet-tabs::-webkit-scrollbar { display: none; }

/* ── ANIMATED STAB ── */
.stab {
  font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:0.1em;
  padding:4px 10px;border-radius:2px;background:transparent;border:1px solid var(--line);
  color:var(--fg2);cursor:none;text-transform:uppercase;flex-shrink:0;
  transition:border-color 0.18s,color 0.18s,background 0.18s,
             transform 0.15s cubic-bezier(0.34,1.56,0.64,1),
             box-shadow 0.18s;
}
.stab:hover {
  border-color:var(--line-hi);color:var(--fg1);
  transform:translateY(-1px);
  box-shadow:0 3px 10px var(--shadow);
}
.stab.active {
  background:var(--bg3);border-color:var(--line-hi);color:var(--fg0);
  transform:translateY(-1px);
  box-shadow:0 3px 10px var(--shadow);
}
/* sliding underline on active tab */
.stab.active::after {
  content:''; display:block; position:absolute; bottom:-1px; left:0; right:0;
  height:2px; background:var(--fg0); border-radius:1px;
  animation:tab-slide-in 0.2s cubic-bezier(0.23,1,0.32,1);
}
@keyframes tab-slide-in { from{transform:scaleX(0)} to{transform:scaleX(1)} }
.stab { position: relative; }

/* tab scroll arrows */
#tabs-wrap { display:flex; align-items:center; gap:3px; }
.tab-arrow {
  font-family:'IBM Plex Mono',monospace; font-size:10px; width:18px; height:18px;
  background:transparent; border:1px solid var(--line); border-radius:2px;
  color:var(--fg2); cursor:none; display:flex; align-items:center; justify-content:center;
  flex-shrink:0; transition:all 0.14s; line-height:1;
}
.tab-arrow:hover { border-color:var(--line-hi); color:var(--fg0); background:var(--bg2); }

/* ── PARALLAX LAYERS ── */
#parallax-bg {
  position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden;
}
.px-layer {
  position:absolute; inset:-40px; will-change:transform;
  background-repeat:repeat;
  transition:transform 0.12s cubic-bezier(0.23,1,0.32,1);
}
.px-layer-1 {
  background-image: radial-gradient(circle, var(--line) 1px, transparent 1px);
  background-size: 32px 32px; opacity: 0.4;
}
.px-layer-2 {
  background-image: radial-gradient(circle, var(--line) 1px, transparent 1px);
  background-size: 80px 80px; opacity: 0.2;
}

/* ── SMOOTH THEME TRANSITION ── */
*, *::before, *::after {
  transition-property: background-color, border-color, color;
  transition-duration: 0.25s;
}

/* ── DROPZONE PULSE RING ── */
#dropzone.drag-over::before {
  content:''; position:absolute; inset:-4px; border-radius:4px;
  border:2px solid var(--fg0);
  animation:dz-pulse 0.8s ease-in-out infinite;
}
@keyframes dz-pulse {
  0%,100%{opacity:0.3;transform:scale(1)}
  50%{opacity:0.8;transform:scale(1.01)}
}

/* ── LIVE PREVIEW CANVAS FRAME FLASH ── */
#live-preview-canvas { transition: opacity 0.05s; }
#live-preview-canvas.flash { opacity: 0.85; }

/* ── STAT CELL HOVER ── */
.stat-cell {
  transition: background 0.18s, transform 0.15s cubic-bezier(0.34,1.56,0.64,1);
}
.stat-cell:hover { background: var(--bg3); transform: scale(1.03); }

/* ── BUTTON PRESS ANIMATION ── */
.btn { transition: background 0.15s, border-color 0.15s, color 0.15s,
       transform 0.12s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.15s; }
.btn:not(:disabled):hover { transform: translateY(-1px); box-shadow: 0 4px 12px var(--shadow); }
.btn:not(:disabled):active { transform: scale(0.96) translateY(0); box-shadow: none; }

/* ── SIDEBAR SECTION HOVER ── */
.s-group { transition: border-color 0.25s, background 0.18s; }

/* ── GENERATION OVERLAY ENTRANCE ── */
#gen-modal {
  animation: modal-in 0.22s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes modal-in {
  from { opacity:0; transform:scale(0.92) translateY(12px) }
  to   { opacity:1; transform:scale(1)    translateY(0) }
}

/* ── TOAST ANIMATION ── */
#toast {
  transition: opacity 0.2s, transform 0.25s cubic-bezier(0.34,1.56,0.64,1);
}

/* ── CANVAS AREA SCAN LINE OVERLAY ── */
#canvas-viewport::after {
  content:''; position:absolute; inset:0; pointer-events:none;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 2px,
    rgba(0,0,0,0.015) 2px, rgba(0,0,0,0.015) 4px
  );
  z-index:10;
}

/* ── PROGRESS BAR SHIMMER ── */
.prog-fill {
  position: relative; overflow: hidden;
}
.prog-fill::after {
  content:''; position:absolute; inset:0;
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.3) 50%, transparent 100%);
  animation: shimmer 1.2s infinite;
}
@keyframes shimmer { from{transform:translateX(-100%)} to{transform:translateX(200%)} }

/* ── VIEW CONTROL BUTTONS ── */
.vc-btn {
  transition: all 0.14s cubic-bezier(0.23,1,0.32,1);
}
.vc-btn:hover { transform: translateY(-1px); }
.vc-btn:active { transform: scale(0.95); }

/* ── OUTPUT BODY FADE IN ── */
#lua-output.on {
  animation: fade-up 0.2s ease-out;
}
@keyframes fade-up { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:translateY(0)} }

/* ── SOURCE GROUP SLIDE IN ── */
#src-group {
  animation: slide-in 0.2s ease-out;
}
@keyframes slide-in { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }

/* ── PALETTE DOT HOVER RIPPLE ── */
.pal-dot { position: relative; }
.pal-dot::after {
  content:''; position:absolute; inset:-4px; border-radius:50%;
  border:1px solid transparent; transition:border-color 0.18s, transform 0.18s;
}
.pal-dot:hover::after { border-color:var(--fg2); transform:scale(1.15); }
.pal-dot.active::after { border-color:var(--fg0); transform:scale(1.2); }


/* ── TOPBAR ENHANCEMENTS ── */
#topbar {
  background: linear-gradient(90deg, var(--bg1) 0%, var(--bg2) 50%, var(--bg1) 100%);
  box-shadow: 0 1px 0 var(--line), 0 4px 20px var(--shadow);
}
.tb-wordmark {
  position: relative;
}
.tb-wordmark::after {
  content: '';
  position: absolute; bottom: -2px; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--fg2), transparent);
  opacity: 0.5;
}
.tb-badge {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 8px; letter-spacing: 0.14em; color: var(--fg2);
  border: 1px solid var(--line); border-radius: 2px;
  padding: 2px 6px; margin-left: 6px;
  animation: badge-pulse 4s ease-in-out infinite;
}
@keyframes badge-pulse {
  0%,100%{opacity:0.5} 50%{opacity:1}
}

/* ── SIDEBAR LOGO AREA ── */
.sidebar-logo {
  padding: 14px 14px 10px;
  border-bottom: 1px solid var(--line);
  display: flex; flex-direction: column; gap: 4px;
  background: linear-gradient(180deg, var(--bg2) 0%, transparent 100%);
}
.sl-name {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 11px; font-weight: 700; letter-spacing: 0.2em;
  color: var(--fg0); text-transform: uppercase;
}
.sl-ver {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px; color: var(--fg2); letter-spacing: 0.1em;
}
.sl-dots {
  display: flex; gap: 5px; margin-top: 4px;
}
.sl-dot {
  width: 7px; height: 7px; border-radius: 50%;
  animation: sl-breathe 2.5s ease-in-out infinite;
}
.sl-dot:nth-child(1) { background: var(--fg2); animation-delay: 0s; }
.sl-dot:nth-child(2) { background: var(--fg2); animation-delay: 0.3s; }
.sl-dot:nth-child(3) { background: var(--fg2); animation-delay: 0.6s; }
@keyframes sl-breathe {
  0%,100%{opacity:0.3;transform:scale(1)}
  50%{opacity:0.9;transform:scale(1.3)}
}

/* ── SECTION HEAD HOVER ── */
.s-head {
  cursor: default;
  transition: background 0.18s, padding-left 0.18s;
}
.s-head:hover { background: var(--bg3); padding-left: 18px; }
.s-head:hover .s-head-dot { background: var(--fg0); }

/* ── INPUT FOCUS GLOW ── */
.field input[type=number]:focus,
.field input[type=text]:focus,
.color-hex-inp:focus {
  border-color: var(--acc-dim);
  box-shadow: 0 0 0 2px rgba(255,255,255,0.04);
}

/* ── GENERATE BUTTON PULSE WHEN READY ── */
#btn-gen:not(:disabled) {
  animation: gen-ready 3s ease-in-out infinite;
}
@keyframes gen-ready {
  0%,100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}
  50%{box-shadow:0 0 14px 2px rgba(255,255,255,0.06)}
}

/* ── PREVIEW BAR GRADIENT ── */
#preview-bar {
  background: linear-gradient(90deg, var(--bg1) 0%, var(--bg2) 100%);
  border-bottom: 1px solid var(--line);
}

/* ── CANVAS GLOW ON LOAD ── */
#preview-canvas.loaded {
  animation: canvas-appear 0.3s ease-out;
}
@keyframes canvas-appear {
  from { opacity: 0; transform-origin: center; filter: brightness(0.6); }
  to   { opacity: 1; filter: brightness(1); }
}

/* ── GENERATION MODAL UPGRADE ── */
#gen-modal {
  border-top: 2px solid var(--fg2);
  position: relative; overflow: hidden;
}
#gen-modal::before {
  content: '';
  position: absolute; top: 0; left: -100%; width: 200%; height: 2px;
  background: linear-gradient(90deg, transparent, var(--fg0), transparent);
  animation: gen-scan 1.8s linear infinite;
}
@keyframes gen-scan { to { left: 100%; } }
.gm-bar-fill {
  position: relative; overflow: hidden;
}
.gm-bar-fill::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shimmer 1s infinite;
}

/* ── STATUS BAR PULSE DOT ── */
.sb-pulse {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--fg2); flex-shrink: 0;
  animation: sb-pulse 2s ease-in-out infinite;
}
.sb-pulse.active { background: var(--fg0); animation: sb-pulse-active 1s ease-in-out infinite; }
@keyframes sb-pulse { 0%,100%{opacity:0.3} 50%{opacity:0.8} }
@keyframes sb-pulse-active { 0%,100%{opacity:0.6;transform:scale(1)} 50%{opacity:1;transform:scale(1.3)} }

/* ── OUTPUT STRIP UPGRADE ── */
#output-strip-head {
  background: linear-gradient(90deg, var(--bg2) 0%, var(--bg1) 100%);
}

/* ── FOOTER BAR ── */
#footerbar {
  display: flex; align-items: center; gap: 0;
  height: 26px; flex-shrink: 0;
  background: var(--bg0);
  border-top: 1px solid var(--line);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px; color: var(--fg2);
  padding: 0; overflow: hidden;
  position: relative; z-index: 50;
}
.fb-item {
  padding: 0 12px; height: 100%;
  display: flex; align-items: center; gap: 6px;
  border-right: 1px solid var(--line);
  white-space: nowrap;
  transition: color 0.15s, background 0.15s;
}
.fb-item:hover { background: var(--bg1); color: var(--fg1); }
.fb-copy { color: var(--fg2); }
.fb-copy strong { color: var(--fg1); font-weight: 500; }
.fb-spacer { flex: 1; }
.fb-discord {
  padding: 0 14px; height: 100%;
  display: flex; align-items: center; gap: 7px;
  text-decoration: none;
  color: var(--fg1);
  border-left: 1px solid var(--line);
  transition: background 0.15s, color 0.15s;
  position: relative; overflow: hidden;
}
.fb-discord::before {
  content: '';
  position: absolute; inset: 0;
  background: rgba(255,255,255,0.03);
  opacity: 0; transition: opacity 0.15s;
}
.fb-discord:hover { color: var(--fg0); }
.fb-discord:hover::before { opacity: 1; }
.fb-discord svg {
  width: 12px; height: 12px; fill: currentColor; flex-shrink: 0;
  transition: transform 0.18s cubic-bezier(0.34,1.56,0.64,1);
}
.fb-discord:hover svg { transform: scale(1.2); }
.fb-discord-label {
  font-family: 'IBM Plex Mono', monospace;
  font-size: 9px; letter-spacing: 0.1em;
}
.fb-build {
  padding: 0 12px; height: 100%;
  display: flex; align-items: center; gap: 5px;
  border-left: 1px solid var(--line);
}
.fb-build-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--fg2);
  animation: sb-pulse 3s ease-in-out infinite;
}
.fb-trs-tag {
  color: var(--fg2); letter-spacing: 0.14em;
}

/* ── EMPTY STATE ANIMATION ── */
.empty-glyph {
  animation: empty-float 3s ease-in-out infinite;
}
@keyframes empty-float {
  0%,100%{transform:translateY(0)} 50%{transform:translateY(-6px)}
}

/* ── TOPBAR SEPARATOR LINE ── */
#topbar::after {
  content: '';
  position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--line-hi), transparent);
  opacity: 0.5;
}

/* ── SECTION BODY FADE ── */
.s-body {
  animation: sb-fade 0.2s ease-out;
}
@keyframes sb-fade { from{opacity:0} to{opacity:1} }

/* ── TIMELINE UPGRADE ── */
#timeline {
  background: linear-gradient(180deg, var(--bg2) 0%, var(--bg1) 100%);
}
#timeline.on {
  animation: tl-slide 0.2s ease-out;
}
@keyframes tl-slide { from{height:0;opacity:0} to{height:60px;opacity:1} }

/* ── SCROLLBAR UPGRADE ── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: var(--bg0); }
::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--line-hi); }

/* ── GLOW LINE TOP ── */
#topbar .tb-glow-line {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--fg2) 30%, var(--fg0) 50%, var(--fg2) 70%, transparent 100%);
  opacity: 0.2;
  animation: glow-travel 4s ease-in-out infinite;
}
@keyframes glow-travel {
  0%,100%{opacity:0.1} 50%{opacity:0.35}
}

/* ── SIDEBAR INNER SHADOW ── */
#sidebar {
  box-shadow: inset -1px 0 0 var(--line), 4px 0 12px var(--shadow);
}

/* ── LIVE PREVIEW BAR GRADIENT ── */
#live-preview-wrap {
  background: linear-gradient(90deg, var(--bg2) 0%, var(--bg1) 100%);
}

/* ── VIEW CONTROLS DIVIDER ── */
.vc-sep {
  background: linear-gradient(180deg, transparent, var(--line), transparent);
}

/* ── TOOLTIP ON HOVER FOR VC BTNS ── */
.vc-btn[title]:hover::after {
  content: attr(title);
  position: absolute; top: 110%; left: 50%;
  transform: translateX(-50%);
  background: var(--bg3); border: 1px solid var(--line);
  font-size: 8px; padding: 2px 6px; border-radius: 2px;
  white-space: nowrap; pointer-events: none;
  animation: tt-fade 0.1s ease-out;
}
@keyframes tt-fade { from{opacity:0;transform:translateX(-50%) translateY(-2px)} to{opacity:1;transform:translateX(-50%) translateY(0)} }
.vc-btn { position: relative; }

/* ── FOOTER SCROLL TICKER ── */
.fb-ticker-wrap {
  overflow: hidden; flex: 1; height: 100%;
  display: flex; align-items: center;
  mask-image: linear-gradient(90deg, transparent 0%, black 5%, black 95%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 5%, black 95%, transparent 100%);
}
.fb-ticker {
  display: flex; gap: 40px; white-space: nowrap;
  animation: ticker-scroll 24s linear infinite;
  font-size: 9px; color: var(--fg2); letter-spacing: 0.1em;
}
.fb-ticker-item { flex-shrink: 0; }
.fb-ticker-dot { margin: 0 6px; opacity: 0.4; }
@keyframes ticker-scroll {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

</style>
